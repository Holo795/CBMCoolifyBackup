// CBM — Coolify Backup Manager — controller metadata schema (Prisma 7).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth tables (credentials + optional OAuth)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  // `name` is the display name ("First Last"), kept in sync from first/last.
  name          String
  firstName     String?
  lastName      String?
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("admin")
  // Set by Better Auth's two-factor plugin once a TOTP app is verified.
  twoFactorEnabled Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  apiTokens     ApiToken[]
  twoFactors    TwoFactor[]
}

// Better Auth two-factor plugin: the TOTP secret (encrypted with the auth
// secret) and the hashed/encrypted backup codes of one user, plus its lockout
// counters after repeated wrong codes.
model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Invitation links for onboarding additional users with a preset role. The
// plaintext token is shown once; only its sha256 hash is stored. `claimedAt` is
// set when the invitee opens the link (proving token possession) and is what
// lets the otherwise-closed registration gate accept their signup.
model Invitation {
  id          String    @id @default(cuid())
  email       String
  role        String
  tokenHash   String    @unique
  expiresAt   DateTime
  createdById String
  claimedAt   DateTime?
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([email])
}

// Machine API tokens for programmatic access: the MCP server and any external AI
// agent authenticate with `Authorization: Bearer <token>`. The plaintext is shown
// once at creation; only its sha256 hash is stored. Each token carries its own
// role (never above its creator's) which gates the `/api/v1` REST surface exactly
// like a user's role gates the UI.
model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique // sha256 of the bearer token
  tokenHint   String    @default("") // masked display of the token, e.g. cbm_ab12…7f4c
  role        String    @default("viewer") // viewer | operator | admin
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([createdById])
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

model CoolifyInstance {
  id                String     @id @default(cuid())
  name              String
  baseUrl           String
  apiTokenEnc       String     // encrypted at rest
  enrollTokenHash   String?    @unique // sha256 of the per-instance enrollment token; plaintext is shown once and never stored
  enrollTokenHint   String     @default("") // masked display of the current token, e.g. cbm_ab12…7f4c
  enrollTokenSetAt  DateTime?  // when the current enrollment token was last generated
  // Restore-time server remap when THIS instance is the target and has several
  // servers: { <source server uuid>: <this instance's server uuid> }. Unmapped
  // sources fall back to the first server; single-server targets ignore it.
  serverUuidMap     Json?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  lastSyncedAt      DateTime?
  agents            Agent[]
  resources         Resource[]
  policies          BackupPolicy[]
}

model Agent {
  id            String          @id @default(cuid())
  hostname      String
  tokenHash     String          @unique // sha256 of the agent bearer token
  instanceId    String?
  instance      CoolifyInstance? @relation(fields: [instanceId], references: [id], onDelete: SetNull)
  status        String          @default("pending") // pending | online | offline
  dockerVersion String?
  // Reported by the agent: its version, the image its container runs (as
  // written), and whether it can update itself from CBM (ok | compose | native).
  version       String?
  image         String?
  selfUpdate    String?
  containers    Int?
  // Which Coolify server this agent's Docker host backs up. Auto-detected from
  // the resources it can see locally (serverManual=false), or pinned by hand in
  // the UI / AGENT_SERVER_UUID env (serverManual=true, auto won't overwrite it).
  serverUuid    String?
  serverName    String?
  serverManual  Boolean         @default(false)
  // Settings set in CBM for this agent only (over the defaults in Setting):
  // { concurrency?, minFreeMb?, stagingMode?, logLevel? }. Null = defaults.
  settings         Json?
  // Reported by the agent: settings its host env fixes, and the values it runs with.
  settingsLocked   String[]        @default([])
  settingsInEffect Json?
  lastSeenAt    DateTime?
  createdAt     DateTime        @default(now())
  jobs          AgentJob[]
  snapshots     Snapshot[]
}

model Resource {
  id           String        @id @default(cuid())
  instanceId   String
  instance     CoolifyInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  coolifyUuid  String
  name         String
  type         String        // postgresql | mysql | ... | application | service
  projectName  String        @default("")
  environment  String        @default("")
  // Coolify ids of its project and environment: a link to it in Coolify's UI.
  projectUuid     String?
  environmentUuid String?
  buildPack    String?
  status       String        @default("unknown")
  // Which Coolify server this resource is deployed on (from the Coolify API).
  // Drives which agent backs it up in a multi-server instance.
  serverUuid   String?
  serverName   String?
  // Per-resource backup settings
  backupEnabled Boolean      @default(false)
  // Backups never restart a resource. When liveBackup is true, volumes are
  // copied live without even a brief freeze (at the operator's risk); otherwise
  // the agent briefly freezes the writing containers for a consistent copy.
  liveBackup   Boolean       @default(false)
  // Paths left out of the volume and host-folder copies (see normalizeExcludes
  // in @cbm/shared): `/path` from each root, or a bare name at any depth.
  backupExcludes String[]    @default([])
  // Login an admin set for the logical dumps of this resource's databases,
  // instead of what their containers' environment gives (password master-key
  // encrypted). Null: the environment / Coolify's credentials.
  dumpUser        String?
  dumpPasswordEnc String?
  // Optional pre/post-backup commands, one entry per container (so a multi-
  // container service can quiesce each part). JSON array of
  // { container: string; pre?: string; post?: string } — container "" = primary.
  // A failing pre command aborts the backup; post commands always run.
  hooks        Json?
  // Containers the agent currently sees for this resource: [{ name, service? }]
  // (service = docker compose service, stable across redeploys). Refreshed by
  // agent heartbeats; drives the per-container hook targets in the UI.
  containers   Json?
  retentionOverride Int?
  // Last time we alerted that this resource's scheduled backup is overdue
  // (debounce so we don't re-alert every sweep for the same missed run).
  lastOverdueAlertAt DateTime?
  // Agent-discovered docker facts (cached)
  containerName String?
  containerNames String[]     @default([])
  volumes       String[]      @default([])
  policies     BackupPolicy[]
  snapshots    Snapshot[]
  usage        ResourceUsage[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([instanceId, coolifyUuid])
}

model Destination {
  id              String        @id @default(cuid())
  name            String
  type            String        // local | ssh | s3
  // Storage engine: "tar" (one file per artifact) or "restic" (incremental,
  // deduplicated, encrypted repository — local & s3 only).
  engine          String        @default("tar")
  configEnc       String        // encrypted JSON (paths, creds)
  encryptionEnabled Boolean     @default(false)
  encryptionKeyEnc String?      // encrypted base64 AES key (tar engine)
  resticPasswordEnc String?     // encrypted restic repo password (restic engine)
  // Deep integrity check (opt-in, weekly): restic `check` / tar re-checksum, to
  // catch silent corruption before a restore needs it. Reconciliation (presence)
  // always runs; this re-reads the stored content and is more expensive.
  integrityCheckEnabled Boolean @default(false)
  lastIntegrityAt      DateTime?
  lastIntegrityStatus  String?   // "ok" | an error detail
  // Mirror: every backup written here is also copied to this destination, for a
  // second independent copy (redundancy). Null = no mirror.
  mirrorToId      String?
  mirrorTo        Destination?  @relation("DestinationMirror", fields: [mirrorToId], references: [id], onDelete: SetNull)
  mirrorFrom      Destination[] @relation("DestinationMirror")
  // Protected: CBM never deletes anything here (no retention, no manual or
  // sync deletion, no prune). Cleaning up is left to the storage itself.
  protected       Boolean       @default(false)
  // Mirror copies received here: "source" = deleted with their source (by its
  // retention), "own" = kept by the counts below, whatever happens to the source.
  mirrorRetention String        @default("source")
  mirrorKeepDaily   Int         @default(7)
  mirrorKeepWeekly  Int         @default(4)
  mirrorKeepMonthly Int         @default(6)
  // S3 deletion-protection check: versioning on, and CBM's key can't remove a
  // version for good. "protected" | "unprotected" | "error".
  protectionStatus    String?
  protectionDetail    String?
  protectionCheckedAt DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  policies        BackupPolicy[]
  snapshots       Snapshot[]
  repoUsage       RepoUsage[]
  resourceUsage   ResourceUsage[]
}

model BackupPolicy {
  id            String      @id @default(cuid())
  name          String
  mode          String      @default("backup") // backup | sync
  cron          String      @default("0 2 * * *")
  retentionDaily   Int      @default(7)
  retentionWeekly  Int      @default(4)
  retentionMonthly Int      @default(6)
  enabled       Boolean     @default(true)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  // Scope (most specific wins): a resource override, else one server of an
  // instance, else a whole instance, else global (all null). A resource inherits
  // its server's schedule, then its instance's.
  resourceId    String?
  resource      Resource?   @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  instanceId    String?
  instance      CoolifyInstance? @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  // When set (with instanceId), this policy governs only the resources on that
  // Coolify server (per-server schedule).
  serverUuid    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  snapshots     Snapshot[]
}

model Snapshot {
  id            String       @id @default(cuid())
  resourceId    String
  resource      Resource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  policyId      String?
  policy        BackupPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  destinationId String
  destination   Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  // The agent that produced this snapshot. For a "local" destination the files
  // live on THIS agent's host, so reconciliation/prune/restore must target it.
  agentId       String?
  agent         Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  mode          String       // backup | sync
  captureMode   String       // cold | hot
  status        String       @default("running") // running | succeeded | failed | missing
  // What went wrong without failing the run (a database that couldn't be
  // dumped...): a succeeded snapshot with warnings is shown as such.
  warnings      String[]     @default([])
  destinationDir String
  manifest      Json?
  sizeBytes     BigInt       @default(0)
  error         String?
  runId         String?      // groups snapshots from one scheduled run
  // restic snapshot id when the destination uses the restic engine.
  resticSnapshotId String?
  // restic: one more restic snapshot per volume read in place by restic (see
  // RESTIC_PART_META); forgotten and checked together with resticSnapshotId.
  resticPartIds String[]     @default([])
  // A copy written by a mirror. Stays set once its source is gone: a mirror
  // with its own retention keeps copies after their source was deleted.
  isMirror      Boolean      @default(false)
  // Last time a destination reconciliation confirmed (or missed) these files.
  lastCheckedAt DateTime?
  startedAt     DateTime     @default(now())
  finishedAt    DateTime?
  artifacts     Artifact[]
  restoreJobs   RestoreJob[]
  drills        RestoreDrill[]
  // A mirror copy points at the source snapshot it was copied from, so retention
  // can prune both together. Null for an original (non-mirror) snapshot.
  mirrorOfId    String?
  // Set when the snapshot is being deleted (status "deleting"): the row goes
  // only once an agent has deleted its files; a failed or stuck deletion retries.
  deleteRequestedAt DateTime?
  // SetNull, not Cascade: a mirror copy's row is removed only once ITS files are
  // deleted (see lib/snapshot-removal); a cascade dropped it even when that failed.
  mirrorOf      Snapshot?    @relation("SnapshotMirror", fields: [mirrorOfId], references: [id], onDelete: SetNull)
  mirrors       Snapshot[]   @relation("SnapshotMirror")

  @@index([runId])
  @@index([mirrorOfId])
  // Hot paths: a resource's history, a destination's snapshots, running ones.
  @@index([resourceId, startedAt])
  @@index([destinationId, status])
  @@index([status])
}

model Artifact {
  id         String   @id @default(cuid())
  snapshotId String
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  kind       String
  filename   String
  sizeBytes  BigInt   @default(0)
  sha256     String?
  encrypted  Boolean  @default(false)

  @@index([snapshotId])
}

model RestoreJob {
  id         String   @id @default(cuid())
  snapshotId String
  snapshot   Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  target     String   @default("in_place")
  status     String   @default("running")
  error      String?
  // "→ new" only: the source resource's Coolify uuid, the clone's uuid and the
  // instance it landed on. Later "→ new" restores onto that instance use these
  // pairs to rewire references (env values) from originals to their clones.
  sourceUuid       String?
  targetUuid       String?
  targetInstanceId String?
  // The references rewired into this clone: [{ key, from, to }].
  remapped   Json?
  createdAt  DateTime @default(now())
  finishedAt DateTime?

  @@index([targetInstanceId])

  @@index([snapshotId])
}

// Agent-facing job queue (pulled by agents). The in-process scheduler (and UI,
// API, alerts…) insert rows here; agents poll for their next queued row.
model AgentJob {
  id         String     @id @default(cuid())
  agentId    String
  agent      Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  type       String     // backup | restore
  status     String     @default("queued") // queued | running | succeeded | failed
  payload    Json       // the full Job object (shared contract)
  snapshotId String?    // linked snapshot for backups
  restoreId  String?
  error      String?
  events     JobEvent[]
  createdAt  DateTime   @default(now())
  claimedAt  DateTime?
  finishedAt DateTime?

  // The agent poll (every few seconds), the activity bar and the reaper.
  @@index([agentId, status, createdAt])
  @@index([status, createdAt])
  @@index([snapshotId])
  @@index([restoreId])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  job       AgentJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  level     String   @default("info")
  message   String
  progress  Int?
  ts        DateTime @default(now())

  @@index([jobId, ts])
}

// ---------------------------------------------------------------------------
// App-wide settings (single row, id = "global")
// ---------------------------------------------------------------------------

model Setting {
  id        String   @id @default("global")
  // IANA timezone used for schedule evaluation + timestamp display.
  timezone  String   @default("Europe/Paris")
  // Optional webhook (Discord/Slack/custom) notified when a backup fails.
  alertWebhookUrl String?
  // SMTP for transactional email (password reset, account verification).
  // user/password are encrypted at rest (encryptSecret); env vars override these.
  smtpHost        String?
  smtpPort        Int?
  smtpSecure      Boolean @default(false)
  smtpUser        String?
  smtpPasswordEnc String?
  smtpFrom        String?
  smtpFromName    String?
  // Set true by a successful "send test"; gates the forgot-password link + the
  // verification toggle. Reset to false whenever the SMTP config changes.
  smtpLastVerifiedOk       Boolean @default(false)
  // Soft account-email verification: when on, a verification email is sent but
  // sign-in is never blocked.
  requireEmailVerification Boolean @default(false)
  // --- Self-backup (disaster recovery) ---
  // The controller pg_dumps its own metadata DB (encrypted) to this destination
  // as a SINGLE artefact overwritten in place — recovery always uses the latest.
  // Change-driven + throttled, with a daily safety re-run. Never "local".
  selfBackupEnabled       Boolean   @default(false)
  selfBackupDestinationId String?
  selfBackupLastRunAt     DateTime?
  selfBackupLastStatus    String?
  // Recovery-file bookkeeping (generation counter + staleness fingerprints).
  recoveryFileGeneration  Int       @default(0)
  recoveryFileAt          DateTime?
  recoveryFileDestId      String?
  recoveryFileKeyFp       String?
  // Automatic restore drills: weekly, each backup-enabled resource's latest
  // snapshot is restored into an agent-side sandbox to prove it's restorable.
  // Opt-in (drills use CPU/disk on the agent hosts).
  drillsEnabled           Boolean   @default(false)
  // Two-factor sign-in requirement: "optional" (each user's choice), "admins"
  // (required for admin accounts) or "everyone".
  twoFactorPolicy          String    @default("optional")
  // Agent settings for every agent, unless overridden per agent (Agent.settings).
  agentDefaults            Json?
  // Update agents to the controller's version by themselves, when they're idle
  // and no scheduled backup is about to run.
  agentAutoUpdate          Boolean   @default(false)
  updatedAt DateTime @updatedAt
}

// A restore drill: one snapshot restored into a throwaway agent-side sandbox
// (never Coolify) to prove it's actually restorable. Kept as history.
model RestoreDrill {
  id          String    @id @default(cuid())
  snapshotId  String
  snapshot    Snapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  agentJobId  String?   @unique
  // running | passed | failed (a check failed) | error (the drill itself didn't run)
  status      String    @default("running")
  trigger     String    @default("manual") // manual | scheduled | api
  // Per-artifact outcome: [{ artifact, kind, engine?, ok, detail }]
  checks      Json?
  durationMs  Int?
  error       String?
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([snapshotId, createdAt])
}

// Scheduler bookkeeping, kept out of Setting (whose updatedAt drives the
// change-detected self-backup): the last minute whose schedules were
// evaluated, so the minutes missed while the controller was down (an upgrade,
// a restart) are replayed instead of skipped.
model SchedulerState {
  id         String @id @default("global")
  lastMinute Int
}

// restic: bytes a repository really stores (deduplicated, compressed), measured
// by the daily reconciliation. `scope` is the agent whose host holds the repo
// for a "local" destination (one repo per host), "" for ssh/s3 (one repo).
model RepoUsage {
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  scope         String
  bytes         BigInt
  measuredAt    DateTime    @default(now())

  @@id([destinationId, scope])
}

// restic: what a resource's snapshots really use in a destination's repository
// (data shared with other resources counts for each).
model ResourceUsage {
  resourceId    String
  resource      Resource    @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  destinationId String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  bytes         BigInt
  measuredAt    DateTime    @default(now())

  @@id([resourceId, destinationId])
  @@index([destinationId])
}

// Single sign-on providers configured from Settings (an environment variable
// for a provider wins over its row: config-as-code, shown locked in the UI).
// id: github | google | gitlab | oidc (Authentik, Keycloak... via OpenID
// discovery). The client secret is master-key encrypted.
model SsoProvider {
  id              String   @id
  enabled         Boolean  @default(false)
  clientId        String   @default("")
  clientSecretEnc String?
  // gitlab: a self-managed instance's URL (gitlab.com when empty); oidc: the
  // issuer URL (its /.well-known/openid-configuration is read).
  issuer          String?
  // oidc: the button's label ("Authentik").
  label           String?
  updatedAt       DateTime @updatedAt
}

