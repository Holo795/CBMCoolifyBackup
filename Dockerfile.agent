# Agent image — runs on each Docker host, talks to the local Docker socket.
FROM node:24-alpine AS build
WORKDIR /app
# Every workspace manifest so `npm ci` sees the lockfile's full workspace set.
COPY package.json package-lock.json ./
COPY packages/shared/package.json packages/shared/
COPY packages/agent/package.json packages/agent/
COPY packages/controller/package.json packages/controller/
COPY packages/mcp/package.json packages/mcp/
RUN npm ci -w @cbm/shared -w @cbm/agent --ignore-scripts --no-audit --no-fund
COPY packages/shared packages/shared
COPY packages/agent packages/agent
RUN npm run build --workspace @cbm/shared && npm run build --workspace @cbm/agent \
  && npm ci -w @cbm/shared -w @cbm/agent --omit=dev --ignore-scripts --no-audit --no-fund

# restic is pinned to an upstream release rather than whatever Alpine ships.
FROM restic/restic:0.19.1 AS restic

FROM node:24-alpine AS runtime
# docker-cli: the agent shells out to `docker` for exec/tar/inspect.
# openssh-client + sshpass: restic's SFTP backend (key or password auth, jump host).
# Runs as root: it needs the host's Docker socket, whose group differs per host.
RUN apk add --no-cache docker-cli openssh-client sshpass
COPY --from=restic /usr/bin/restic /usr/bin/restic
WORKDIR /app
ENV NODE_ENV=production
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/packages/shared/package.json ./packages/shared/
COPY --from=build /app/packages/agent/dist ./packages/agent/dist
COPY --from=build /app/packages/agent/package.json ./packages/agent/
ENV AGENT_WORK_DIR=/var/lib/cbm-agent
VOLUME ["/var/run/docker.sock"]
CMD ["node", "packages/agent/dist/index.js"]
